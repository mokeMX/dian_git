menu "Follow-only3: Advanced pure following (Kalman + Adaptive PID + S-Curve)"

comment "--- Drive motors (rear diff-drive: APO-DL ESC + RC PWM) ---"

config FOLLOW3_LEFT_ESC_GPIO
    int "Left ESC signal GPIO (RC PWM out)"
    default 4
    help
        RC servo-pulse output to the rear-LEFT ESC (50 Hz, 1000-2000 us).

config FOLLOW3_RIGHT_ESC_GPIO
    int "Right ESC signal GPIO (RC PWM out)"
    default 5

config FOLLOW3_ESC_MIN_US
    int "ESC pulse: full reverse (us)"
    default 1000

config FOLLOW3_ESC_MID_US
    int "ESC pulse: neutral / stop (us)"
    default 1500

config FOLLOW3_ESC_MAX_US
    int "ESC pulse: full forward (us)"
    default 2000

config FOLLOW3_ESC_ARM_MS
    int "Hold neutral this long at boot so the ESC arms (ms)"
    default 2000

comment "--- AB encoders (closed-loop speed feedback) ---"

config FOLLOW3_LEFT_ENC_A_GPIO
    int "Left encoder A GPIO"
    default 6

config FOLLOW3_LEFT_ENC_B_GPIO
    int "Left encoder B GPIO"
    default 7

config FOLLOW3_RIGHT_ENC_A_GPIO
    int "Right encoder A GPIO"
    default 15

config FOLLOW3_RIGHT_ENC_B_GPIO
    int "Right encoder B GPIO"
    default 16

config FOLLOW3_TICKS_PER_METER
    int "Encoder ticks (4x) per metre of wheel travel - CALIBRATE"
    default 2000
    help
        4x quadrature counts for one metre of forward travel.

comment "--- Wheel-speed PID ---"

config FOLLOW3_SPEED_KP
    int "Speed loop KP (us per m/s)"
    default 200

config FOLLOW3_SPEED_KI
    int "Speed loop KI (us per m/s per s)"
    default 300

config FOLLOW3_SPEED_KD
    int "Speed loop KD (us per m/s/s)"
    default 5

config FOLLOW3_SPEED_PID_LIMIT_US
    int "Max PID contribution per wheel (us)"
    default 400

config FOLLOW3_TRACK_WIDTH_MM
    int "Track width: distance between the two rear wheels (mm)"
    default 300

config FOLLOW3_MAX_WHEEL_SPEED_MMPS
    int "Top wheel speed (mm/s)"
    default 800

comment "--- Follow behaviour ---"

config FOLLOW3_FOLLOW_DISTANCE_MM
    int "Desired standoff distance behind the user (mm)"
    default 1000
    help
        Base follow distance. Dynamically adjusted by target speed.

config FOLLOW3_STOP_BAND_MM
    int "Stop band below standoff where the robot holds still (mm)"
    default 250

config FOLLOW3_MAX_LINEAR_MMPS
    int "Max follow linear speed (mm/s)"
    default 700

config FOLLOW3_MAX_ANGULAR_MRADPS
    int "Max yaw rate (milli-rad/s)"
    default 1600

config FOLLOW3_KP_DIST
    int "Follow Kp: range error -> linear velocity (milli)"
    default 900
    help
        Base proportional gain for distance control. Adaptive scaling
        increases gain when error is large.

config FOLLOW3_KP_BEAR
    int "Follow Kp: bearing error -> yaw rate (milli)"
    default 1600
    help
        Base proportional gain for bearing control. Adaptive scaling
        increases gain at low speeds for sharper turns.

config FOLLOW3_SEARCH_ANGULAR_MRADPS
    int "Search rotation speed (milli-rad/s)"
    default 800

config FOLLOW3_SEARCH_TIMEOUT_S
    int "Search timeout before going IDLE (seconds)"
    default 6

config FOLLOW3_TARGET_FRESH_MS
    int "UWB data freshness threshold (ms)"
    default 700

comment "--- Kalman Filter (noise reduction + velocity estimation) ---"

config FOLLOW3_KF_DIST_Q
    int "Kalman: distance process noise Q (x0.0001 m^2)"
    default 300
    help
        Larger Q trusts the prediction less, making filter faster to
        respond but less smooth. Typical: 100-500.

config FOLLOW3_KF_DIST_R
    int "Kalman: distance measurement noise R (x0.0001 m^2)"
    default 1600
    help
        Larger R trusts the UWB less, making filter smoother but
        slower to respond. Typical: 400-2500 (20cm = 0.04 m^2).

config FOLLOW3_KF_BEAR_Q
    int "Kalman: bearing process noise Q (x0.0001 rad^2)"
    default 200
    help
        Larger Q makes filter faster to respond to bearing changes.

config FOLLOW3_KF_BEAR_R
    int "Kalman: bearing measurement noise R (x0.0001 rad^2)"
    default 800
    help
        Larger R makes bearing estimates smoother.

comment "--- S-Curve velocity profiling (jerk limiting) ---"

config FOLLOW3_MAX_JERK
    int "Max linear jerk (x0.001 m/s^3)"
    default 1500
    help
        Rate of change of acceleration. Lower = smoother but less responsive.
        Typical: 500-2000.

config FOLLOW3_MAX_ACCEL
    int "Max linear acceleration (x0.001 m/s^2)"
    default 800
    help
        Max acceleration limit. Same as before but as part of S-curve.

config FOLLOW3_MAX_ANG_ACCEL
    int "Max angular acceleration (x0.001 rad/s^2)"
    default 6000

comment "--- Complementary filter (IMU gyro + encoder fusion) ---"

config FOLLOW3_CF_ALPHA
    int "Complementary filter alpha (x0.001)"
    default 980
    help
        Weight for gyroscope vs encoder. 980 = 98% gyro + 2% encoder.
        Gyro has good short-term response but drifts; encoder has no
        drift but slower. Typical: 950-990.

comment "--- Dynamic follow distance ---"

config FOLLOW3_DYN_DIST_FACTOR
    int "Dynamic distance speed factor (x0.001)"
    default 500
    help
        Extra distance (m) per m/s of target speed. Default 500 = 0.5s
        of extra distance per m/s (so at 1m/s target, add 0.5m).

comment "--- IMU heading closed-loop ---"

config FOLLOW3_HEADING_KP_MILLI
    int "Heading-hold KP (milli, rad/s per rad of error)"
    default 1500
    help
        The IMU heading loop uses complementary-filtered yaw for
        improved stability.

config FOLLOW3_I2C_SDA_GPIO
    int "IMU I2C SDA GPIO"
    default 39

config FOLLOW3_I2C_SCL_GPIO
    int "IMU I2C SCL GPIO"
    default 38

config FOLLOW3_IMU_ADDR
    hex "IMU 7-bit I2C address"
    default 0x23

comment "--- UWB sensor ---"

config FOLLOW3_UWB_UART
    int "BU UWB UART port"
    default 1

config FOLLOW3_UWB_RX_GPIO
    int "BU UWB ESP RX GPIO"
    default 18

config FOLLOW3_UWB_TX_GPIO
    int "BU UWB ESP TX GPIO"
    default 37

config FOLLOW3_UWB_BAUD
    int "BU UWB baudrate"
    default 115200

config FOLLOW3_CONTROL_HZ
    int "Control loop frequency (Hz)"
    default 50

endmenu
